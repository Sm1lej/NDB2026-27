<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="WarsztatPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>Data.entity.ClientEnt</class>
        <class>Data.entity.VehicleEnt</class>
        <class>Data.entity.CarEnt</class>
        <class>Data.entity.MotorbikeEnt</class>
        <class>Data.entity.ServiceEnt</class>
        <class>Data.entity.AppointmentEnt</class>
        <class>Data.entity.InvoiceEnt</class>
        <class>Data.entity.RepairServiceEnt</class>
        <class>Data.entity.DiagnosticServiceEnt</class>
        <class>Data.entity.ClientTypeEnt</class>
<!--        <class>entity.DiamondClientTypeEnt</class>-->
<!--        <class>entity.GoldClientTypeEnt</class>-->
<!--        <class>entity.DefaultClientTypeEnt</class>-->
        <class>Data.entity.AddressEnt</class>


        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>
        <validation-mode>CALLBACK</validation-mode>

        <properties>

            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/nbddb"/>
            <property name="jakarta.persistence.jdbc.user" value="nbd"/>
            <property name="jakarta.persistence.jdbc.password" value="nbdpassword"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>

        </properties>
    </persistence-unit>
</persistence>