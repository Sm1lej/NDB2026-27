<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="WarsztatPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>Data.PostgreSQL.entity.ClientEnt</class>
        <class>Data.PostgreSQL.entity.VehicleEnt</class>
        <class>Data.PostgreSQL.entity.CarEnt</class>
        <class>Data.PostgreSQL.entity.MotorbikeEnt</class>
        <class>Data.PostgreSQL.entity.ServiceEnt</class>
        <class>Data.PostgreSQL.entity.AppointmentEnt</class>
        <class>Data.PostgreSQL.entity.InvoiceEnt</class>
        <class>Data.PostgreSQL.entity.RepairServiceEnt</class>
        <class>Data.PostgreSQL.entity.DiagnosticServiceEnt</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <shared-cache-mode>NONE</shared-cache-mode>


        <properties>

            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/nbddb"/>
            <property name="jakarta.persistence.jdbc.user" value="nbd"/>
            <property name="jakarta.persistence.jdbc.password" value="nbdpassword"/>
            <property name="hibernate.connection.isolation" value="2"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
            <property name="jakarta.persistence.validation.mode" value="none"/>
        </properties>

    </persistence-unit>
</persistence>